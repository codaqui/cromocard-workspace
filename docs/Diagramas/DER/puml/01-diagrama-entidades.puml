@startuml 01_Diagrama_de_Entidades
' =====================================================================
'  CromoCard - Sistema de Gestao de Cartas Colecionaveis
'  1/3 - DIAGRAMA DE ENTIDADES  (entidades + atributos, sem ligacoes)
'  Cole em https://www.plantuml.com/plantuml/uml/ e exporte em SVG.
'  Modulos organizados em grade 3x3 com cores para leitura impressa.
' =====================================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Verdana
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 45
skinparam packageStyle rectangle
skinparam titleFontSize 22
skinparam titleFontStyle bold

skinparam package {
  FontSize 15
  FontStyle bold
  FontColor #22303F
  BorderThickness 2
  BorderColor #8C96A5
}

skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #6B7280
  BorderThickness 1
  FontSize 13
  FontStyle bold
  FontColor #1F2937
  AttributeFontSize 12
  AttributeFontColor #374151
}

hide circle
hide empty methods

title CromoCard — Diagrama de Entidades (Modelo Logico)

legend bottom
  |= Marcacao |= Significado |
  | <b>*</b> | Campo obrigatorio (NOT NULL) |
  | <b>o</b> | Campo opcional (NULL) |
  | <b><<PK>></b> | Chave primaria |
  | <b><<FK>></b> | Chave estrangeira |
  | <b><<UQ>></b> | Valor unico |
  | <i>3 x 3</i> | 8 modulos - as ligacoes estao no diagrama 02 |
endlegend

' =====================================================================
' MODULO 1
' =====================================================================
package "1. Usuarios, Perfil e Acesso" as M1 #E8EEF9 {

  entity users {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(120)
    * email : varchar(160) <<UQ>>
    o password_hash : varchar(255)
    * role : enum
    * status : enum
    * email_verified : boolean
    * terms_accepted : boolean
    o oauth_provider : varchar(30)
    o oauth_id : varchar(120)
    o phone : varchar(20)
    o username : varchar(30) <<UQ>>
    o last_login_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity profiles {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>> <<UQ>>
    -- Atributos --
    o bio : text
    o avatar_url : varchar(255)
    o city : varchar(120)
    * portfolio_privacy : enum
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity addresses {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>>
    -- Atributos --
    * label : varchar(60)
    * zip_code : varchar(9)
    * street : varchar(160)
    * number : varchar(15)
    o complement : varchar(60)
    * neighborhood : varchar(90)
    * city : varchar(90)
    * state : char(2)
    * is_primary : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity password_reset_tokens {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>>
    -- Atributos --
    * token : varchar(255) <<UQ>>
    * expires_at : timestamptz
    * used : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity refresh_tokens {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>>
    -- Atributos --
    * token_hash : varchar(255) <<UQ>>
    * expires_at : timestamptz
    o revoked_at : timestamptz
    o user_agent : varchar(255)
    o ip_address : varchar(45)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity achievements {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(90) <<UQ>>
    * description : varchar(255)
    o icon_url : varchar(255)
    * criteria : varchar(255)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity user_achievements {
    * user_id : uuid <<PK>> <<FK>>
    * achievement_id : uuid <<PK>> <<FK>>
    -- Atributos --
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity subscriptions {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>>
    -- Atributos --
    * plan : varchar(20)
    * status : enum
    * payment_method : enum
    * start_date : date
    o end_date : date
    o gateway_reference : varchar(120)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 2
' =====================================================================
package "2. Catalogo Global (Albuns e Cartas)" as M2 #E6F3EC {

  entity categories {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    o parent_category_id : uuid <<FK>>
    -- Atributos --
    * name : varchar(90)
    * type : enum
    o description : varchar(255)
    * is_default : boolean
    * slug : varchar(100) <<UQ>>
    * display_order : integer
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity rarities {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(60) <<UQ>>
    * sort_order : smallint
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity languages {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(60)
    * code : varchar(5) <<UQ>>
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity card_conditions {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(60) <<UQ>>
    * sort_order : smallint
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity albums {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    o category_id : uuid <<FK>>
    -- Atributos --
    * title : varchar(160)
    o publisher : varchar(120)
    o year : smallint
    o description : text
    o cover_url : varchar(255)
    * total_cards : integer
    * status : enum
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity cards {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    o album_id : uuid <<FK>>
    o category_id : uuid <<FK>>
    o rarity_id : uuid <<FK>>
    o language_id : uuid <<FK>>
    -- Atributos --
    * name : varchar(160)
    o number : varchar(20)
    o description : text
    o front_image_url : varchar(255)
    o back_image_url : varchar(255)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity card_photos {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * card_id : uuid <<FK>>
    -- Atributos --
    * url : varchar(255)
    * sort_order : smallint
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity price_history {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * card_id : uuid <<FK>>
    -- Atributos --
    * price : decimal(10,2)
    * reference_date : date
    * source : enum
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 3
' =====================================================================
package "3. Colecao do Cliente" as M3 #F0E9F7 {

  entity collections {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>> <<UQ>>
    -- Atributos --
    * is_public : boolean
    o share_link : varchar(120) <<UQ>>
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity user_albums {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * collection_id : uuid <<FK>>
    * album_id : uuid <<FK>>
    -- Atributos --
    * is_favorite : boolean
    * progress_percentage : decimal(5,2)
    .. UQ (collection_id, album_id) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity collection_cards {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * collection_id : uuid <<FK>>
    * card_id : uuid <<FK>>
    -- Atributos --
    * status : enum
    * quantity : integer
    o market_value : decimal(10,2)
    .. UQ (collection_id, card_id) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 4
' =====================================================================
package "4. Comunidade (Grupos)" as M4 #FBEEE3 {

  entity groups {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * creator_id : uuid <<FK>>
    -- Atributos --
    * name : varchar(120)
    o description : text
    o cover_image_url : varchar(255)
    * access_type : enum
    * status : enum
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity group_members {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * group_id : uuid <<FK>>
    * user_id : uuid <<FK>>
    -- Atributos --
    * role : enum
    o muted_until : timestamptz
    .. UQ (group_id, user_id) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity group_join_requests {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * group_id : uuid <<FK>>
    * user_id : uuid <<FK>>
    o reviewed_by_id : uuid <<FK>>
    -- Atributos --
    * status : enum
    o reviewed_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity group_messages {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * group_id : uuid <<FK>>
    * author_id : uuid <<FK>>
    o reply_to_id : uuid <<FK>>
    o card_id : uuid <<FK>>
    o listing_id : uuid <<FK>>
    -- Atributos --
    * content_type : enum
    o content : text
    o attachment_url : varchar(255)
    * pinned : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity polls {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * group_message_id : uuid <<FK>> <<UQ>>
    -- Atributos --
    * question : varchar(255)
    * multiple_choice : boolean
    o closes_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity poll_options {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * poll_id : uuid <<FK>>
    -- Atributos --
    * text : varchar(160)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity poll_votes {
    * poll_option_id : uuid <<PK>> <<FK>>
    * user_id : uuid <<PK>> <<FK>>
    -- Atributos --
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 5
' =====================================================================
package "5. Chat Pessoal" as M5 #E4F2F5 {

  entity conversations {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    o listing_id : uuid <<FK>>
    -- Atributos --
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity conversation_participants {
    * conversation_id : uuid <<PK>> <<FK>>
    * user_id : uuid <<PK>> <<FK>>
    -- Atributos --
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity messages {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * conversation_id : uuid <<FK>>
    * author_id : uuid <<FK>>
    o reply_to_id : uuid <<FK>>
    -- Atributos --
    o content : text
    o attachment_url : varchar(255)
    * is_read : boolean
    o read_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity user_blocks {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * blocker_id : uuid <<FK>>
    * blocked_id : uuid <<FK>>
    -- Atributos --
    .. UQ (blocker_id, blocked_id) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 6
' =====================================================================
package "6. Marketplace (Anuncios, Pedidos, Avaliacoes)" as M6 #FBE9EF {

  entity listings {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * seller_id : uuid <<FK>>
    * card_id : uuid <<FK>>
    o condition_id : uuid <<FK>>
    -- Atributos --
    * price : decimal(10,2)
    * available_quantity : integer
    o description : text
    * status : enum
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity listing_photos {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * listing_id : uuid <<FK>>
    -- Atributos --
    * url : varchar(255)
    * sort_order : smallint
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity offers {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * listing_id : uuid <<FK>>
    * buyer_id : uuid <<FK>>
    -- Atributos --
    * offered_amount : decimal(10,2)
    o message : varchar(255)
    * status : enum
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity orders {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * listing_id : uuid <<FK>>
    * buyer_id : uuid <<FK>>
    * seller_id : uuid <<FK>>
    * shipping_address_id : uuid <<FK>>
    -- Atributos --
    * quantity : integer
    * items_amount : decimal(10,2)
    * shipping_amount : decimal(10,2)
    * total_amount : decimal(10,2)
    * shipping_method : varchar(60)
    * status : enum
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity payments {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * order_id : uuid <<FK>> <<UQ>>
    -- Atributos --
    * method : enum
    * value : decimal(10,2)
    * status : enum
    o gateway_reference : varchar(120)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity reviews {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * order_id : uuid <<FK>> <<UQ>>
    * author_id : uuid <<FK>>
    * seller_id : uuid <<FK>>
    -- Atributos --
    * rating : smallint
    o comment : varchar(500)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 7
' =====================================================================
package "7. Notificacoes e Favoritos" as M7 #FCF5E0 {

  entity favorites {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * user_id : uuid <<FK>>
    o album_id : uuid <<FK>>
    o card_id : uuid <<FK>>
    o group_id : uuid <<FK>>
    -- Atributos --
    * type : enum
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity price_alerts {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * user_id : uuid <<FK>>
    * card_id : uuid <<FK>>
    -- Atributos --
    * target_price : decimal(10,2)
    * active : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity notifications {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * user_id : uuid <<FK>>
    o global_notification_id : uuid <<FK>>
    -- Atributos --
    * title : varchar(120)
    * message : varchar(500)
    * type : varchar(40)
    o reference_link : varchar(255)
    * is_read : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity global_notifications {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * admin_id : uuid <<FK>>
    -- Atributos --
    * title : varchar(120)
    * content : varchar(500)
    * recipient_count : integer
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 8
' =====================================================================
package "8. Moderacao e Administracao" as M8 #ECECEF {

  entity reports {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * reporter_id : uuid <<FK>>
    o moderator_id : uuid <<FK>>
    o listing_id : uuid <<FK>>
    o target_user_id : uuid <<FK>>
    o group_message_id : uuid <<FK>>
    -- Atributos --
    * target_type : enum
    * reason : varchar(90)
    o description : varchar(500)
    * status : enum
    o resolved_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity catalog_requests {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * requester_id : uuid <<FK>>
    o reviewed_by_id : uuid <<FK>>
    o card_id : uuid <<FK>>
    o album_id : uuid <<FK>>
    -- Atributos --
    * type : enum
    * data : jsonb
    * status : enum
    o reviewed_at : timestamptz
    o rejection_reason : varchar(255)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity audit_logs {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * admin_id : uuid <<FK>>
    -- Atributos --
    * action : varchar(90)
    * entity_type : varchar(60)
    o entity_id : uuid
    o details : jsonb
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity global_settings {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    o updated_by_id : uuid <<FK>>
    -- Atributos --
    * key : varchar(90) <<UQ>>
    * value : text
    o description : varchar(255)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' LAYOUT - grade 3x3 (ligacoes invisiveis, nao aparecem no desenho)
'   linha 1: M1 | M2 | M3
'   linha 2: M4 | M5 | M6
'   linha 3: M7 | M8
' =====================================================================
users  -[hidden]right- categories
categories -[hidden]right- collections
users  -[hidden]down-  groups
groups    -[hidden]right- conversations
conversations -[hidden]right- listings
groups    -[hidden]down-  favorites
favorites -[hidden]right- reports

@enduml

@startuml 02_Diagrama_de_Relacionamentos
' =====================================================================
'  CromoCard - Sistema de Gestao de Cartas Colecionaveis
'  2/3 - DIAGRAMA DE RELACIONAMENTOS  (entidades + cardinalidades)
'
'  DECISOES DE LAYOUT (testadas renderizando 4 variantes):
'  1) "left to right direction" -> o desenho fica em RETRATO
'     (~1900 x 3100) em vez de uma tira de 4500 x 1350. A tira nao
'     cabia legivel na pagina e ainda estourava o limite de 4096px
'     do servidor, cortando entidades do lado direito.
'  2) SEM caixas de "package": a entidade "users" se liga a 26 das
'     90 relacoes. Com caixas, o layout tem de cruzar todas elas e o
'     desenho vira um emaranhado. Aqui o modulo e indicado pela COR
'     de fundo da entidade (ver legenda).
'  3) Rotulos apenas onde ha mais de uma ligacao entre o mesmo par.
'
'  Somente chaves (PK/FK). Os atributos completos estao no diagrama 01.
'  Cole em https://www.plantuml.com/plantuml/uml/ e exporte em SVG.
' =====================================================================

left to right direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Verdana
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 55
skinparam titleFontSize 22
skinparam titleFontStyle bold

skinparam entity {
  BorderColor #6B7280
  BorderThickness 1
  FontSize 13
  FontStyle bold
  FontColor #1F2937
  AttributeFontSize 11
  AttributeFontColor #4B5563
}

skinparam ArrowColor #5A6B85
skinparam ArrowThickness 1.1
skinparam ArrowFontSize 11
skinparam ArrowFontColor #33415C

hide circle
hide empty methods

title CromoCard — Diagrama de Relacionamentos (pe-de-galinha)

legend bottom
  |= Cor |= Modulo |= Notacao |= Leitura |
  |<#DCE7F7>    | 1. Usuarios, Perfil e Acesso | &#124;&#124;--&#124;&#124; | um para um |
  |<#DCEFE4>    | 2. Catalogo Global | &#124;&#124;--o{ | um para zero ou muitos |
  |<#EBE0F5>    | 3. Colecao do Cliente | &#124;&#124;--&#124;{ | um para um ou muitos |
  |<#FAE5D3>    | 4. Comunidade (Grupos) | &#124;o--o{ | zero-ou-um para zero ou muitos |
  |<#D9EDF2>    | 5. Chat Pessoal | <<PK>> | chave primaria |
  |<#F8DFE7>    | 6. Marketplace | <<FK>> | chave estrangeira |
  |<#FBF0D0>    | 7. Notificacoes e Favoritos | * / o | campo obrigatorio / opcional |
  |<#E6E6EA>    | 8. Moderacao e Administracao | //rotulo// | so existe rotulo quando ha mais de uma ligacao entre o mesmo par |
endlegend

' =====================================================================
' ENTIDADES  (cor de fundo = modulo)
' =====================================================================

' --- 1. Usuarios, Perfil e Acesso ------------------------------------
entity users #DCE7F7 {
  * id <<PK>>
}
entity profiles #DCE7F7 {
  * id <<PK>>
  * user_id <<FK>>
}
entity addresses #DCE7F7 {
  * id <<PK>>
  * user_id <<FK>>
}
entity password_reset_tokens #DCE7F7 {
  * id <<PK>>
  * user_id <<FK>>
}
entity refresh_tokens #DCE7F7 {
  * id <<PK>>
  * user_id <<FK>>
}
entity achievements #DCE7F7 {
  * id <<PK>>
}
entity user_achievements #DCE7F7 {
  * user_id <<PK, FK>>
  * achievement_id <<PK, FK>>
}
entity subscriptions #DCE7F7 {
  * id <<PK>>
  * user_id <<FK>>
}

' --- 2. Catalogo Global ----------------------------------------------
entity categories #DCEFE4 {
  * id <<PK>>
  o parent_category_id <<FK>>
}
entity rarities #DCEFE4 {
  * id <<PK>>
}
entity languages #DCEFE4 {
  * id <<PK>>
}
entity card_conditions #DCEFE4 {
  * id <<PK>>
}
entity albums #DCEFE4 {
  * id <<PK>>
  o category_id <<FK>>
}
entity cards #DCEFE4 {
  * id <<PK>>
  o album_id <<FK>>
  o category_id <<FK>>
  o rarity_id <<FK>>
  o language_id <<FK>>
}
entity card_photos #DCEFE4 {
  * id <<PK>>
  * card_id <<FK>>
}
entity price_history #DCEFE4 {
  * id <<PK>>
  * card_id <<FK>>
}

' --- 3. Colecao do Cliente -------------------------------------------
entity collections #EBE0F5 {
  * id <<PK>>
  * user_id <<FK>>
}
entity user_albums #EBE0F5 {
  * id <<PK>>
  * collection_id <<FK>>
  * album_id <<FK>>
}
entity collection_cards #EBE0F5 {
  * id <<PK>>
  * collection_id <<FK>>
  * card_id <<FK>>
}

' --- 4. Comunidade (Grupos) ------------------------------------------
entity groups #FAE5D3 {
  * id <<PK>>
  * creator_id <<FK>>
}
entity group_members #FAE5D3 {
  * id <<PK>>
  * group_id <<FK>>
  * user_id <<FK>>
}
entity group_join_requests #FAE5D3 {
  * id <<PK>>
  * group_id <<FK>>
  * user_id <<FK>>
  o reviewed_by_id <<FK>>
}
entity group_messages #FAE5D3 {
  * id <<PK>>
  * group_id <<FK>>
  * author_id <<FK>>
  o reply_to_id <<FK>>
  o card_id <<FK>>
  o listing_id <<FK>>
}
entity polls #FAE5D3 {
  * id <<PK>>
  * group_message_id <<FK>>
}
entity poll_options #FAE5D3 {
  * id <<PK>>
  * poll_id <<FK>>
}
entity poll_votes #FAE5D3 {
  * poll_option_id <<PK, FK>>
  * user_id <<PK, FK>>
}

' --- 5. Chat Pessoal --------------------------------------------------
entity conversations #D9EDF2 {
  * id <<PK>>
  o listing_id <<FK>>
}
entity conversation_participants #D9EDF2 {
  * conversation_id <<PK, FK>>
  * user_id <<PK, FK>>
}
entity messages #D9EDF2 {
  * id <<PK>>
  * conversation_id <<FK>>
  * author_id <<FK>>
  o reply_to_id <<FK>>
}
entity user_blocks #D9EDF2 {
  * id <<PK>>
  * blocker_id <<FK>>
  * blocked_id <<FK>>
}

' --- 6. Marketplace ---------------------------------------------------
entity listings #F8DFE7 {
  * id <<PK>>
  * seller_id <<FK>>
  * card_id <<FK>>
  o condition_id <<FK>>
}
entity listing_photos #F8DFE7 {
  * id <<PK>>
  * listing_id <<FK>>
}
entity offers #F8DFE7 {
  * id <<PK>>
  * listing_id <<FK>>
  * buyer_id <<FK>>
}
entity orders #F8DFE7 {
  * id <<PK>>
  * listing_id <<FK>>
  * buyer_id <<FK>>
  * seller_id <<FK>>
  * shipping_address_id <<FK>>
}
entity payments #F8DFE7 {
  * id <<PK>>
  * order_id <<FK>>
}
entity reviews #F8DFE7 {
  * id <<PK>>
  * order_id <<FK>>
  * author_id <<FK>>
  * seller_id <<FK>>
}

' --- 7. Notificacoes e Favoritos --------------------------------------
entity favorites #FBF0D0 {
  * id <<PK>>
  * user_id <<FK>>
  o album_id <<FK>>
  o card_id <<FK>>
  o group_id <<FK>>
}
entity price_alerts #FBF0D0 {
  * id <<PK>>
  * user_id <<FK>>
  * card_id <<FK>>
}
entity global_notifications #FBF0D0 {
  * id <<PK>>
  * admin_id <<FK>>
}
entity notifications #FBF0D0 {
  * id <<PK>>
  * user_id <<FK>>
  o global_notification_id <<FK>>
}

' --- 8. Moderacao e Administracao -------------------------------------
entity reports #E6E6EA {
  * id <<PK>>
  * reporter_id <<FK>>
  o moderator_id <<FK>>
  o listing_id <<FK>>
  o target_user_id <<FK>>
  o group_message_id <<FK>>
}
entity catalog_requests #E6E6EA {
  * id <<PK>>
  * requester_id <<FK>>
  o reviewed_by_id <<FK>>
  o card_id <<FK>>
  o album_id <<FK>>
}
entity audit_logs #E6E6EA {
  * id <<PK>>
  * admin_id <<FK>>
}
entity global_settings #E6E6EA {
  * id <<PK>>
  o updated_by_id <<FK>>
}
entity seller_verifications #E6E6EA {
  * id <<PK>>
  * user_id <<FK>>
  o reviewed_by_id <<FK>>
  o address_id <<FK>>
}
entity seller_documents #E6E6EA {
  * id <<PK>>
  * seller_verification_id <<FK>>
  o validated_by_id <<FK>>
}
entity seller_verification_notes #E6E6EA {
  * id <<PK>>
  * seller_verification_id <<FK>>
  * author_id <<FK>>
}
entity user_warnings #E6E6EA {
  * id <<PK>>
  * user_id <<FK>>
  * admin_id <<FK>>
  o report_id <<FK>>
}
entity catalog_request_votes #E6E6EA {
  * catalog_request_id <<PK, FK>>
  * user_id <<PK, FK>>
}
entity report_exports #E6E6EA {
  * id <<PK>>
  * admin_id <<FK>>
}

' =====================================================================
' RELACIONAMENTOS
' Rotulo somente quando existe MAIS DE UMA ligacao entre o mesmo par
' de entidades (ou auto-relacionamento) - nos demais casos o nome da
' FK ja identifica a ligacao e o rotulo so poluiria o desenho.
' =====================================================================

' --- 1. Usuarios, Perfil e Acesso ------------------------------------
users   ||--|| profiles
users   ||--o{ addresses
users   ||--o{ password_reset_tokens
users   ||--o{ refresh_tokens
users   ||--o{ user_achievements
achievements ||--o{ user_achievements
users   ||--o{ subscriptions

' --- 2. Catalogo Global ----------------------------------------------
categories |o--o{ categories : pai
categories ||--o{ albums
categories ||--o{ cards
rarities  ||--o{ cards
languages    ||--o{ cards
albums     ||--o{ cards
cards     ||--o{ card_photos
cards     ||--o{ price_history

' --- 3. Colecao do Cliente -------------------------------------------
users ||--|| collections
collections ||--o{ user_albums
albums   ||--o{ user_albums
collections ||--o{ collection_cards
cards   ||--o{ collection_cards

' --- 4. Comunidade (Grupos) ------------------------------------------
users        ||--o{ groups             : criador
groups          ||--|{ group_members
users        ||--o{ group_members
groups          ||--o{ group_join_requests
users        ||--o{ group_join_requests : solicitante
users        |o--o{ group_join_requests : avaliador
groups          ||--o{ group_messages
users        ||--o{ group_messages    : autor
group_messages |o--o{ group_messages    : resposta
cards          |o--o{ group_messages
listings        |o--o{ group_messages
group_messages ||--|| polls
polls        ||--|{ poll_options
poll_options  ||--o{ poll_votes
users        ||--o{ poll_votes

' --- 5. Chat Pessoal --------------------------------------------------
conversations ||--|{ conversation_participants
users  ||--o{ conversation_participants
conversations ||--o{ messages
users  ||--o{ messages         : autor
message |o--o{ messages         : resposta
listings  |o--o{ conversations
users  ||--o{ user_blocks : bloqueador
users  ||--o{ user_blocks : bloqueado

' --- 6. Marketplace ---------------------------------------------------
users            ||--o{ listings   : vendedor
cards              ||--o{ listings
card_conditions |o--o{ listings
listings            ||--o{ listing_photos
listings            ||--o{ offers
users            ||--o{ offers  : comprador
listings            ||--o{ orders
users            ||--o{ orders    : comprador
users            ||--o{ orders    : vendedor
addresses           ||--o{ orders
orders             ||--|| payments
orders             ||--|| reviews
users            ||--o{ reviews : autor
users            ||--o{ reviews : avaliado

' --- 7. Notificacoes e Favoritos --------------------------------------
users            ||--o{ favorites
albums              |o--o{ favorites
cards              |o--o{ favorites
groups              |o--o{ favorites
users            ||--o{ price_alerts
cards              ||--o{ price_alerts
users            ||--o{ notifications
global_notifications |o--o{ notifications
users            ||--o{ global_notifications : admin

' --- 8. Moderacao e Administracao -------------------------------------
users        ||--o{ reports             : denunciante
users        |o--o{ reports             : moderador
users        |o--o{ reports             : alvo
listings        |o--o{ reports
group_messages |o--o{ reports
users        ||--o{ catalog_requests : solicitante
users        |o--o{ catalog_requests : avaliador
cards          |o--o{ catalog_requests
albums          |o--o{ catalog_requests
users        ||--o{ audit_logs        : admin
users        |o--o{ global_settings  : admin
users        ||--o| seller_verifications : credencia
users        |o--o{ seller_verifications : avalia
addresses    |o--o{ seller_verifications : endereco comercial
seller_verifications ||--o{ seller_documents : anexa
users        |o--o{ seller_documents : valida
seller_verifications ||--o{ seller_verification_notes : anota
users        ||--o{ seller_verification_notes : escreve
users        ||--o{ user_warnings : recebe
users        ||--o{ user_warnings : aplica
reports      |o--o{ user_warnings : origina
catalog_requests ||--o{ catalog_request_votes : recebe voto
users        ||--o{ catalog_request_votes : vota
users        ||--o{ report_exports : exporta

@enduml

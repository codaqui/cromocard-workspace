@startuml 03_DER_Completo
' =====================================================================
'  CromoCard - Sistema de Gestao de Cartas Colecionaveis
'  3/3 - DER COMPLETO  (entidades + atributos + relacionamentos)
'  Cole em https://www.plantuml.com/plantuml/uml/
'  LAYOUT: "left to right direction" deixa o desenho em RETRATO
'  (~3265 x 6055). Sem isso ele vira uma tira de 7938 x 2018, que nao
'  cabe legivel na pagina e estoura o limite de 4096px do PNG.
'  DICA DE IMPRESSAO: exporte em SVG (nao PNG) - o SVG mantem o texto
'  nitido em qualquer zoom e e o melhor formato para colar no relatorio.
' =====================================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Verdana
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 65
skinparam packageStyle rectangle
skinparam titleFontSize 22
skinparam titleFontStyle bold

skinparam package {
  FontSize 15
  FontStyle bold
  FontColor #22303F
  BorderThickness 2
  BorderColor #8C96A5
}

skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #6B7280
  BorderThickness 1
  FontSize 13
  FontStyle bold
  FontColor #1F2937
  AttributeFontSize 11
  AttributeFontColor #374151
}

skinparam ArrowColor #52607A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 11
skinparam ArrowFontColor #33415C

hide circle
hide empty methods

left to right direction

title CromoCard — DER Completo (50 entidades / 8 modulos)

legend bottom
  |= Marcacao |= Significado |
  | <b>*</b> / <b>o</b> | obrigatorio (NOT NULL) / opcional (NULL) |
  | <b><<PK>> <<FK>> <<UQ>></b> | chave primaria / estrangeira / valor unico |
  | <b>&#124;&#124;--o{</b> | um para zero ou muitos |
  | <b>&#124;&#124;--&#124;{</b> | um para um ou muitos |
  | <b>&#124;&#124;--&#124;&#124;</b> | um para um |
  | <b>&#124;o--o{</b> | zero-ou-um para zero ou muitos |
endlegend

' =====================================================================
' MODULO 1 - USUARIOS, PERFIL E ACESSO
' =====================================================================
package "1. Usuarios, Perfil e Acesso" as M1 #E8EEF9 {

  entity users {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(120)
    * email : varchar(160) <<UQ>>
    o password_hash : varchar(255)
    * role : enum (CUSTOMER, SELLER, ADMIN)
    * status : enum (ACTIVE, SUSPENDED, BLOCKED)
    * email_verified : boolean
    * terms_accepted : boolean
    o oauth_provider : varchar(30)
    o oauth_id : varchar(120)
    o username : varchar(30) <<UQ>>
    o phone : varchar(20)
    o cpf : varchar(14) <<UQ>>
    o last_login_at : timestamptz
    o last_login_ip : varchar(45)
    o suspended_until : timestamptz
    .. unique(oauth_provider, oauth_id) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity profiles {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>> <<UQ>>
    -- Atributos --
    o bio : text
    o avatar_url : varchar(255)
    o city : varchar(120)
    * portfolio_privacy : enum (PUBLIC, PRIVATE)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity addresses {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>>
    -- Atributos --
    * label : varchar(60)
    * zip_code : varchar(9)
    * street : varchar(160)
    * number : varchar(15)
    o complement : varchar(60)
    * neighborhood : varchar(90)
    * city : varchar(90)
    * state : char(2)
    * is_primary : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity password_reset_tokens {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>>
    -- Atributos --
    * token : varchar(255) <<UQ>>
    * expires_at : timestamptz
    * used : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity refresh_tokens {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>>
    -- Atributos --
    * token_hash : varchar(255) <<UQ>>
    * expires_at : timestamptz
    o revoked_at : timestamptz
    o user_agent : varchar(255)
    o ip_address : varchar(45)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity achievements {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(90) <<UQ>>
    * description : varchar(255)
    o icon_url : varchar(255)
    * criteria : varchar(255)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity user_achievements {
    * user_id : uuid <<PK>> <<FK>>
    * achievement_id : uuid <<PK>> <<FK>>
    -- Atributos --
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity subscriptions {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>>
    -- Atributos --
    * plan : varchar(20)
    * status : enum (ACTIVE, CANCELED, EXPIRED)
    * payment_method : enum
    * start_date : date
    o end_date : date
    o gateway_reference : varchar(120)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 2 - CATALOGO GLOBAL
' =====================================================================
package "2. Catalogo Global (Albuns e Cartas)" as M2 #E6F3EC {

  entity categories {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    o parent_category_id : uuid <<FK>>
    -- Atributos --
    * name : varchar(90)
    * type : enum (ALBUM, CARD)
    o description : varchar(255)
    * is_default : boolean
    o slug : varchar(100) <<UQ>>
    * display_order : integer
    * is_pinned : boolean
    o badge : varchar(20)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity rarities {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(60) <<UQ>>
    * sort_order : smallint
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity languages {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(60)
    * code : varchar(5) <<UQ>>
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity card_conditions {
    * id : uuid <<PK>>
    -- Atributos --
    * name : varchar(60) <<UQ>>
    * sort_order : smallint
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity albums {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    o category_id : uuid <<FK>>
    -- Atributos --
    * title : varchar(160)
    o publisher : varchar(120)
    o year : smallint
    o description : text
    o cover_url : varchar(255)
    * total_cards : integer
    * status : enum (ACTIVE, INACTIVE)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity cards {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    o album_id : uuid <<FK>>
    o category_id : uuid <<FK>>
    o rarity_id : uuid <<FK>>
    o language_id : uuid <<FK>>
    -- Atributos --
    * name : varchar(160)
    o number : varchar(20)
    o description : text
    o front_image_url : varchar(255)
    o back_image_url : varchar(255)
    * status : enum (DRAFT, ACTIVE)
    o code : varchar(30) <<UQ>>
    o variants : varchar(120)
    o release_year : smallint
    .. UQ (album_id, number) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity card_photos {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * card_id : uuid <<FK>>
    -- Atributos --
    * url : varchar(255)
    * sort_order : smallint
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity price_history {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * card_id : uuid <<FK>>
    -- Atributos --
    * price : decimal(10,2)
    * reference_date : date
    * source : enum (SALE, LISTING)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 3 - COLECAO DO CLIENTE
' =====================================================================
package "3. Colecao do Cliente" as M3 #F0E9F7 {

  entity collections {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * user_id : uuid <<FK>> <<UQ>>
    -- Atributos --
    * is_public : boolean
    o share_link : varchar(120) <<UQ>>
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity user_albums {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * collection_id : uuid <<FK>>
    * album_id : uuid <<FK>>
    -- Atributos --
    * is_favorite : boolean
    * progress_percentage : decimal(5,2)
    .. UQ (collection_id, album_id) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity collection_cards {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * collection_id : uuid <<FK>>
    * card_id : uuid <<FK>>
    -- Atributos --
    * status : enum (OWNED, MISSING, DUPLICATE)
    * quantity : integer
    o market_value : decimal(10,2)
    .. UQ (collection_id, card_id) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 4 - COMUNIDADE (GRUPOS)
' =====================================================================
package "4. Comunidade (Grupos)" as M4 #FBEEE3 {

  entity groups {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * creator_id : uuid <<FK>>
    -- Atributos --
    * name : varchar(120)
    o description : text
    o cover_image_url : varchar(255)
    * access_type : enum (OPEN, CLOSED)
    * status : enum (ACTIVE, WARNED, SUSPENDED)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity group_members {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * group_id : uuid <<FK>>
    * user_id : uuid <<FK>>
    -- Atributos --
    * role : enum (MEMBER, ADMIN)
    o muted_until : timestamptz
    .. UQ (group_id, user_id) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity group_join_requests {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * group_id : uuid <<FK>>
    * user_id : uuid <<FK>>
    o reviewed_by_id : uuid <<FK>>
    -- Atributos --
    * status : enum (PENDING, APPROVED, REJECTED)
    o reviewed_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity group_messages {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * group_id : uuid <<FK>>
    * author_id : uuid <<FK>>
    o reply_to_id : uuid <<FK>>
    o card_id : uuid <<FK>>
    o listing_id : uuid <<FK>>
    -- Atributos --
    * content_type : enum (TEXT, IMAGE, CARD, LISTING, POLL)
    o content : text
    o attachment_url : varchar(255)
    * pinned : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity polls {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * group_message_id : uuid <<FK>> <<UQ>>
    -- Atributos --
    * question : varchar(255)
    * multiple_choice : boolean
    o closes_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity poll_options {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * poll_id : uuid <<FK>>
    -- Atributos --
    * text : varchar(160)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity poll_votes {
    * poll_option_id : uuid <<PK>> <<FK>>
    * user_id : uuid <<PK>> <<FK>>
    -- Atributos --
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 5 - CHAT PESSOAL
' =====================================================================
package "5. Chat Pessoal" as M5 #E4F2F5 {

  entity conversations {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    o listing_id : uuid <<FK>>
    -- Atributos --
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity conversation_participants {
    * conversation_id : uuid <<PK>> <<FK>>
    * user_id : uuid <<PK>> <<FK>>
    -- Atributos --
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity messages {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * conversation_id : uuid <<FK>>
    * author_id : uuid <<FK>>
    o reply_to_id : uuid <<FK>>
    -- Atributos --
    o content : text
    o attachment_url : varchar(255)
    * is_read : boolean
    o read_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity user_blocks {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * blocker_id : uuid <<FK>>
    * blocked_id : uuid <<FK>>
    -- Atributos --
    .. UQ (blocker_id, blocked_id) ..
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 6 - MARKETPLACE
' =====================================================================
package "6. Marketplace (Anuncios, Pedidos, Avaliacoes)" as M6 #FBE9EF {

  entity listings {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * seller_id : uuid <<FK>>
    * card_id : uuid <<FK>>
    o condition_id : uuid <<FK>>
    -- Atributos --
    * price : decimal(10,2)
    * available_quantity : integer
    o description : text
    * status : enum (ACTIVE, PAUSED, CLOSED)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity listing_photos {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * listing_id : uuid <<FK>>
    -- Atributos --
    * url : varchar(255)
    * sort_order : smallint
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity offers {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * listing_id : uuid <<FK>>
    * buyer_id : uuid <<FK>>
    -- Atributos --
    * offered_amount : decimal(10,2)
    o message : varchar(255)
    * status : enum (PENDING, ACCEPTED, REJECTED, EXPIRED)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity orders {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * listing_id : uuid <<FK>>
    * buyer_id : uuid <<FK>>
    * seller_id : uuid <<FK>>
    * shipping_address_id : uuid <<FK>>
    -- Atributos --
    * quantity : integer
    * items_amount : decimal(10,2)
    * shipping_amount : decimal(10,2)
    * total_amount : decimal(10,2)
    * shipping_method : varchar(60)
    * status : enum (AWAITING_PAYMENT, PAID, SHIPPED, DELIVERED, CANCELED)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity payments {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * order_id : uuid <<FK>> <<UQ>>
    -- Atributos --
    * method : enum (CREDIT_CARD, PIX, BOLETO)
    * value : decimal(10,2)
    * status : enum (PENDING, APPROVED, REJECTED, REFUNDED)
    o gateway_reference : varchar(120)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity reviews {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * order_id : uuid <<FK>> <<UQ>>
    * author_id : uuid <<FK>>
    * seller_id : uuid <<FK>>
    -- Atributos --
    * rating : smallint (1 a 5)
    o comment : varchar(500)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 7 - NOTIFICACOES E FAVORITOS
' =====================================================================
package "7. Notificacoes e Favoritos" as M7 #FCF5E0 {

  entity favorites {

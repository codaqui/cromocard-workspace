  }

  entity price_alerts {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * user_id : uuid <<FK>>
    * card_id : uuid <<FK>>
    -- Atributos --
    * target_price : decimal(10,2)
    * active : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity notifications {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --

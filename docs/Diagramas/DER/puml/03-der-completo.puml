    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}

' =====================================================================
' MODULO 8 - MODERACAO E ADMINISTRACAO
' =====================================================================
package "8. Moderacao e Administracao" as M8 #ECECEF {

  entity reports {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * reporter_id : uuid <<FK>>
    o moderator_id : uuid <<FK>>
    o listing_id : uuid <<FK>>
    o target_user_id : uuid <<FK>>
    o group_message_id : uuid <<FK>>
    -- Atributos --
    * target_type : enum (LISTING, SELLER, USER, PROFILE, GROUP_MESSAGE)
    * reason : varchar(90)
    o description : varchar(500)
    * status : enum (PENDING, UNDER_REVIEW, RESOLVED, DISMISSED)
    o resolved_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity catalog_requests {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * requester_id : uuid <<FK>>
    o reviewed_by_id : uuid <<FK>>
    o card_id : uuid <<FK>>
    o album_id : uuid <<FK>>
    -- Atributos --
    * type : enum (CARD, ALBUM, CATEGORY)
    * data : jsonb
    * status : enum (PENDING, APPROVED, REJECTED)
    o reviewed_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity audit_logs {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * admin_id : uuid <<FK>>
    -- Atributos --
    * action : varchar(90)
    * entity_type : varchar(60)
    o entity_id : uuid
    o details : jsonb
    o ip_address : varchar(45)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity global_settings {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    o updated_by_id : uuid <<FK>>
    -- Atributos --
    * key : varchar(90) <<UQ>>
    * value : text
    o description : varchar(255)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity seller_verifications {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * user_id : uuid <<FK>> <<UQ>>
    o reviewed_by_id : uuid <<FK>>
    o address_id : uuid <<FK>>
    -- Atributos --
    * status : enum (UNDER_REVIEW, PENDING, APPROVED, REJECTED)
    * legal_name : varchar(160)
    o trade_name : varchar(160)
    * cnpj : varchar(18) <<UQ>>
    o state_registration : varchar(30)
    o opening_date : date
    o company_size : varchar(40)
    o cnae : varchar(120)
    * responsible_name : varchar(120)
    * responsible_cpf : varchar(14)
    o responsible_phone : varchar(20)
    o bank_name : varchar(80)
    o bank_branch : varchar(10)
    o bank_account : varchar(20)
    o pix_key : varchar(120)
    o rejection_reason : varchar(255)
    o regularization_deadline : timestamptz
    o reviewed_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity seller_documents {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * seller_verification_id : uuid <<FK>>
    o validated_by_id : uuid <<FK>>
    -- Atributos --
    * type : varchar(60)
    * file_url : varchar(255)
    o file_size : integer
    * status : enum (SUBMITTED, VALIDATED)
    o validated_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity seller_verification_notes {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * seller_verification_id : uuid <<FK>>
    * author_id : uuid <<FK>>
    -- Atributos --
    * content : text
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity user_warnings {
    * id : uuid <<PK>>
    -- Chaves estrangeiras --
    * user_id : uuid <<FK>>
    * admin_id : uuid <<FK>>
    o report_id : uuid <<FK>>
    -- Atributos --
    * reason : varchar(255)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity catalog_request_votes {
    * catalog_request_id : uuid <<PK>> <<FK>>
    * user_id : uuid <<PK>> <<FK>>
    -- Atributos --
    * vote : enum (FOR, NEUTRAL, AGAINST)
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }

  entity report_exports {
    * id : uuid <<PK>>
    -- Chave estrangeira --
    * admin_id : uuid <<FK>>
    -- Atributos --
    * report_type : varchar(60)
    o filters : jsonb
    * format : varchar(10)
    * file_url : varchar(255)
    o file_size : integer
    * expires_at : timestamptz
    * created_at : timestamptz
    * updated_at : timestamptz
    o deleted_at : timestamptz
  }
}


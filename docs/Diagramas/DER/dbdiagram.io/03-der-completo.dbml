// =====================================================================
//  CromoCard - Sistema de Gestao de Cartas Colecionaveis
//  3/3 - DER COMPLETO (entidades + atributos + relacionamentos)
//  Cole em https://dbdiagram.io/d
//  Organizacao: 50 tabelas, 8 modulos (cores por modulo + TableGroup),
//  relacionamentos declarados no final, agrupados por modulo.
//  Export sugerido para o relatorio: PDF ou PNG (botao Export).
// =====================================================================

Project CromoCard {
  database_type: 'PostgreSQL'
  Note: 'DER do sistema de gestao de cartas colecionaveis, comunidade e marketplace. Modulos: Usuarios/Perfil, Catalogo, Colecao, Comunidade, Chat Pessoal, Marketplace, Notificacoes/Favoritos, Moderacao/Admin.'
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------
Enum user_role {
  CUSTOMER
  SELLER
  ADMIN
}

Enum user_status {
  ACTIVE
  SUSPENDED
  BLOCKED
}

Enum privacy {
  PUBLIC
  PRIVATE
}

Enum category_type {
  ALBUM
  CARD
}

Enum album_status {
  ACTIVE
  INACTIVE
}

Enum price_source {
  SALE
  LISTING
}

Enum subscription_status {
  ACTIVE
  CANCELED
  EXPIRED
}

Enum collection_card_status {
  OWNED
  MISSING
  DUPLICATE
}

Enum group_access_type {
  OPEN
  CLOSED
}

Enum group_status {
  ACTIVE
  WARNED
  SUSPENDED
}

Enum member_role {
  MEMBER
  ADMIN
}

Enum request_status {
  PENDING
  APPROVED
  REJECTED
}

Enum message_content_type {
  TEXT
  IMAGE
  CARD
  LISTING
  POLL
}

Enum listing_status {
  ACTIVE
  PAUSED
  CLOSED
}

Enum offer_status {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

Enum order_status {
  AWAITING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

Enum payment_method {
  CREDIT_CARD
  PIX
  BOLETO
}

Enum payment_status {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

Enum favorite_type {
  ALBUM
  CARD
  GROUP
}

Enum report_target_type {
  LISTING
  SELLER
  USER
  PROFILE
  GROUP_MESSAGE
}

Enum report_status {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

Enum catalog_request_type {
  CARD
  ALBUM
  CATEGORY
}

Enum seller_verification_status {
  UNDER_REVIEW
  PENDING
  APPROVED
  REJECTED
}

Enum seller_document_status {
  SUBMITTED
  VALIDATED
}

Enum card_status {
  DRAFT
  ACTIVE
}

Enum notification_dispatch_status {
  SCHEDULED
  SENT
  CANCELED
}

Enum catalog_vote {
  FOR
  NEUTRAL
  AGAINST
}

// =====================================================================
// MODULO 1 - USUARIOS, PERFIL E ACESSO
// =====================================================================
Table users [headercolor: #3E5F8A] {
  id             uuid         [pk, default: `uuidv7()`]
  name           varchar(120) [not null]
  email          varchar(160) [not null, unique]
  password_hash  varchar(255)
  role           user_role    [not null]
  status         user_status  [not null, default: 'ACTIVE']
  email_verified boolean      [not null, default: false]
  terms_accepted boolean      [not null, default: false]
  oauth_provider varchar(30)
  oauth_id       varchar(120)
  username       varchar(30) [unique, note: 'Nome de usuario (@) (CCD098, ADR-053)']
  phone          varchar(20) [note: 'Telefone com DDD (CCD098)']
  cpf            varchar(14) [unique, note: 'CPF, visivel so no BackOffice (CCD098)']
  last_login_at  timestamptz [note: 'Ultimo login bem-sucedido (CCD098)']
  last_login_ip  varchar(45) [note: 'IP do ultimo login (CCD098)']
  suspended_until timestamptz [note: 'Fim da suspensao temporaria; nulo = sem prazo (CCD099)']
  created_at     timestamptz  [not null, default: `now()`]
  updated_at     timestamptz  [not null, default: `now()`, note: 'Atualizado pelo Prisma (@updatedAt)']
  deleted_at     timestamptz  [note: 'Soft delete (ADR-015)']
  indexes {
    (oauth_provider, oauth_id) [unique, note: 'Conta Google unica (ADR-048)']
  }
  Note: 'Conta unica da plataforma; o tipo define o acesso (Cliente, Vendedor, Administrador).'
}

Table profiles [headercolor: #3E5F8A] {
  id                uuid         [pk, default: `uuidv7()`]
  user_id           uuid         [not null, unique]
  bio               text
  avatar_url        varchar(255)
  city              varchar(120)
  portfolio_privacy privacy      [not null, default: 'PUBLIC']
  created_at        timestamptz  [not null, default: `now()`]
  updated_at        timestamptz  [not null, default: `now()`]
  deleted_at        timestamptz
}

Table addresses [headercolor: #3E5F8A] {
  id           uuid         [pk, default: `uuidv7()`]
  user_id      uuid         [not null]
  label        varchar(60)  [not null]
  zip_code     varchar(9)   [not null]
  street       varchar(160) [not null]
  number       varchar(15)  [not null]
  complement   varchar(60)
  neighborhood varchar(90)  [not null]
  city         varchar(90)  [not null]
  state        char(2)      [not null]
  is_primary   boolean      [not null, default: false]
  created_at   timestamptz  [not null, default: `now()`]
  updated_at   timestamptz  [not null, default: `now()`]
  deleted_at   timestamptz
}

Table password_reset_tokens [headercolor: #3E5F8A] {
  id         uuid         [pk, default: `uuidv7()`]
  user_id    uuid         [not null]
  token      varchar(255) [not null, unique, note: 'Hash (SHA-256) do token; o valor puro so vai no link do e-mail (ADR-048)']
  expires_at timestamptz  [not null]
  used       boolean      [not null, default: false]
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]
  deleted_at timestamptz
}

Table refresh_tokens [headercolor: #3E5F8A] {
  id         uuid         [pk, default: `uuidv7()`]
  user_id    uuid         [not null]
  token_hash varchar(255) [not null, unique, note: 'Hash (SHA-256) do refresh token; o valor puro nunca e salvo']
  expires_at timestamptz  [not null, note: 'Mais longo quando o usuario marca "lembrar usuario"']
  revoked_at timestamptz  [note: 'Preenchido no logout ou na rotacao do token']
  user_agent varchar(255)
  ip_address varchar(45)
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Sessoes de login (JWT access token curto + refresh token rotativo).'
}

Table achievements [headercolor: #3E5F8A] {
  id          uuid         [pk, default: `uuidv7()`]
  name        varchar(90)  [not null, unique]
  description varchar(255) [not null]
  icon_url    varchar(255)
  criteria    varchar(255) [not null]
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]
  deleted_at  timestamptz
}

Table user_achievements [headercolor: #3E5F8A] {
  user_id        uuid        [not null]
  achievement_id uuid        [not null]
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]
  deleted_at     timestamptz
  indexes {
    (user_id, achievement_id) [pk]
  }
}

Table subscriptions [headercolor: #3E5F8A] {
  id                uuid                [pk, default: `uuidv7()`]
  user_id           uuid                [not null]
  plan              varchar(20)         [not null, default: 'PRO']
  status            subscription_status [not null, default: 'ACTIVE']
  payment_method    payment_method      [not null]
  start_date        date                [not null]
  end_date          date
  gateway_reference varchar(120)
  created_at        timestamptz         [not null, default: `now()`]
  updated_at        timestamptz         [not null, default: `now()`]
  deleted_at        timestamptz
  Note: 'Plano PRO (funcionalidade futura).'
}

// =====================================================================
// MODULO 2 - CATALOGO GLOBAL (ALBUNS E CARTAS)
// =====================================================================
Table categories [headercolor: #2E7D5B] {
  id                 uuid          [pk, default: `uuidv7()`]
  parent_category_id uuid          [note: 'Hierarquia: selecao / time']
  name               varchar(90)   [not null]
  type               category_type [not null]
  description        varchar(255)
  is_default         boolean       [not null, default: false]
  slug               varchar(100) [unique, note: 'Gerado a partir do nome (CCD104)']
  display_order      integer [not null, default: 0, note: 'Ordem no menu, nos filtros e na vitrine (CCD104)']
  is_pinned          boolean [not null, default: false, note: 'Fixada no topo (CCD104)']
  badge              varchar(20) [note: 'Selo de exibicao: STANDARD ou TRENDING (CCD104)']
  created_at         timestamptz   [not null, default: `now()`]
  updated_at         timestamptz   [not null, default: `now()`]
  deleted_at         timestamptz
}

Table rarities [headercolor: #2E7D5B] {
  id         uuid        [pk, default: `uuidv7()`]
  name       varchar(60) [not null, unique]
  sort_order smallint    [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table languages [headercolor: #2E7D5B] {
  id         uuid        [pk, default: `uuidv7()`]
  name       varchar(60) [not null]
  code       varchar(5)  [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table card_conditions [headercolor: #2E7D5B] {
  id         uuid        [pk, default: `uuidv7()`]
  name       varchar(60) [not null, unique]
  sort_order smallint    [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Ex.: Mint, Near Mint, Otimo, Bom, Regular.'
}

Table albums [headercolor: #2E7D5B] {
  id          uuid         [pk, default: `uuidv7()`]
  category_id uuid
  title       varchar(160) [not null]
  publisher   varchar(120)
  year        smallint
  description text
  cover_url   varchar(255)
  total_cards integer      [not null, default: 0]
  status      album_status [not null, default: 'ACTIVE']
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]
  deleted_at  timestamptz
}

Table cards [headercolor: #2E7D5B] {
  id              uuid         [pk, default: `uuidv7()`]
  album_id        uuid         [note: 'Nulo = carta avulsa / portfolio']
  category_id     uuid
  rarity_id       uuid
  language_id     uuid
  name            varchar(160) [not null]
  number          varchar(20)
  description     text
  front_image_url varchar(255)
  back_image_url  varchar(255)
  status          card_status [not null, default: 'ACTIVE', note: 'DRAFT = rascunho fora do catalogo (CCD106)']
  code            varchar(30) [unique, note: 'Codigo da carta, ex.: CRD-POK-0004 (CCD105)']
  variants        varchar(120) [note: 'Variantes separadas por virgula, ex.: Shadowless, Holofoil (CCD105)']
  release_year    smallint [note: 'Ano de lancamento da carta (CCD106)']
  created_at      timestamptz  [not null, default: `now()`]
  updated_at      timestamptz  [not null, default: `now()`]
  deleted_at      timestamptz
  indexes {
    (album_id, number) [unique]
  }
}

Table card_photos [headercolor: #2E7D5B] {
  id         uuid         [pk, default: `uuidv7()`]
  card_id    uuid         [not null]
  url        varchar(255) [not null]
  sort_order smallint     [not null, default: 0]
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]
  deleted_at timestamptz
}

Table price_history [headercolor: #2E7D5B] {
  id             uuid          [pk, default: `uuidv7()`]
  card_id        uuid          [not null]
  price          decimal(10,2) [not null]
  reference_date date          [not null]
  source         price_source  [not null]
  created_at     timestamptz   [not null, default: `now()`]
  updated_at     timestamptz   [not null, default: `now()`]
  deleted_at     timestamptz
}

// =====================================================================
// MODULO 3 - COLECAO DO CLIENTE
// =====================================================================
Table collections [headercolor: #7B4F9D] {
  id         uuid         [pk, default: `uuidv7()`]
  user_id    uuid         [not null, unique]
  is_public  boolean      [not null, default: false]
  share_link varchar(120) [unique]
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]
  deleted_at timestamptz
}

Table user_albums [headercolor: #7B4F9D] {
  id                  uuid         [pk, default: `uuidv7()`]
  collection_id       uuid         [not null]
  album_id            uuid         [not null]
  is_favorite         boolean      [not null, default: false]
  progress_percentage decimal(5,2) [not null, default: 0]
  created_at          timestamptz  [not null, default: `now()`]
  updated_at          timestamptz  [not null, default: `now()`]
  deleted_at          timestamptz
  indexes {
    (collection_id, album_id) [unique]
  }
}

Table collection_cards [headercolor: #7B4F9D] {
  id            uuid                   [pk, default: `uuidv7()`]
  collection_id uuid                   [not null]
  card_id       uuid                   [not null]
  status        collection_card_status [not null]
  quantity      integer                [not null, default: 1]
  market_value  decimal(10,2)
  created_at    timestamptz            [not null, default: `now()`]
  updated_at    timestamptz            [not null, default: `now()`]
  deleted_at    timestamptz
  indexes {
    (collection_id, card_id) [unique]
  }
}

// =====================================================================
// MODULO 4 - COMUNIDADE (GRUPOS)
// =====================================================================
Table groups [headercolor: #C2703D] {
  id              uuid              [pk, default: `uuidv7()`]
  creator_id      uuid              [not null]
  name            varchar(120)      [not null]
  description     text
  cover_image_url varchar(255)
  access_type     group_access_type [not null]
  status          group_status      [not null, default: 'ACTIVE']
  created_at      timestamptz       [not null, default: `now()`]
  updated_at      timestamptz       [not null, default: `now()`]
  deleted_at      timestamptz
}

Table group_members [headercolor: #C2703D] {
  id          uuid        [pk, default: `uuidv7()`]
  group_id    uuid        [not null]
  user_id     uuid        [not null]
  role        member_role [not null, default: 'MEMBER']
  muted_until timestamptz [note: 'Silenciar notificacoes do grupo']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
  deleted_at  timestamptz
  indexes {
    (group_id, user_id) [unique]
  }
}

Table group_join_requests [headercolor: #C2703D] {
  id             uuid           [pk, default: `uuidv7()`]
  group_id       uuid           [not null]
  user_id        uuid           [not null]
  reviewed_by_id uuid
  status         request_status [not null, default: 'PENDING']
  reviewed_at    timestamptz
  created_at     timestamptz    [not null, default: `now()`]
  updated_at     timestamptz    [not null, default: `now()`]
  deleted_at     timestamptz
}

Table group_messages [headercolor: #C2703D] {
  id             uuid                 [pk, default: `uuidv7()`]
  group_id       uuid                 [not null]
  author_id      uuid                 [not null]
  reply_to_id    uuid
  card_id        uuid
  listing_id     uuid
  content_type   message_content_type [not null, default: 'TEXT']
  content        text
  attachment_url varchar(255)
  pinned         boolean              [not null, default: false]
  created_at     timestamptz          [not null, default: `now()`]
  updated_at     timestamptz          [not null, default: `now()`]
  deleted_at     timestamptz
}

Table polls [headercolor: #C2703D] {
  id               uuid         [pk, default: `uuidv7()`]
  group_message_id uuid         [not null, unique]
  question         varchar(255) [not null]
  multiple_choice  boolean      [not null, default: false]
  closes_at        timestamptz
  created_at       timestamptz  [not null, default: `now()`]
  updated_at       timestamptz  [not null, default: `now()`]
  deleted_at       timestamptz
}

Table poll_options [headercolor: #C2703D] {
  id         uuid         [pk, default: `uuidv7()`]
  poll_id    uuid         [not null]
  text       varchar(160) [not null]
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]
  deleted_at timestamptz
}

Table poll_votes [headercolor: #C2703D] {
  poll_option_id uuid        [not null]
  user_id        uuid        [not null]
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]
  deleted_at     timestamptz
  indexes {
    (poll_option_id, user_id) [pk]
  }
}

// =====================================================================
// MODULO 5 - CHAT PESSOAL
// =====================================================================
Table conversations [headercolor: #2A7B8C] {
  id         uuid        [pk, default: `uuidv7()`]
  listing_id uuid        [note: 'Preenchido quando a conversa nasce de um anuncio']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table conversation_participants [headercolor: #2A7B8C] {
  conversation_id uuid        [not null]
  user_id         uuid        [not null]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]
  deleted_at      timestamptz
  indexes {
    (conversation_id, user_id) [pk]
  }
}

Table messages [headercolor: #2A7B8C] {
  id              uuid         [pk, default: `uuidv7()`]
  conversation_id uuid         [not null]
  author_id       uuid         [not null]
  reply_to_id     uuid
  content         text
  attachment_url  varchar(255)
  is_read         boolean      [not null, default: false]
  read_at         timestamptz
  created_at      timestamptz  [not null, default: `now()`]
  updated_at      timestamptz  [not null, default: `now()`]
  deleted_at      timestamptz
}

Table user_blocks [headercolor: #2A7B8C] {
  id         uuid        [pk, default: `uuidv7()`]
  blocker_id uuid        [not null]
  blocked_id uuid        [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  indexes {
    (blocker_id, blocked_id) [unique]
  }
}

// =====================================================================
// MODULO 6 - MARKETPLACE (ANUNCIOS, PEDIDOS, AVALIACOES)
// =====================================================================
Table listings [headercolor: #A63D5F] {
  id                 uuid           [pk, default: `uuidv7()`]
  seller_id          uuid           [not null]
  card_id            uuid           [not null]
  condition_id       uuid
  price              decimal(10,2)  [not null]
  available_quantity integer        [not null, default: 1]
  description        text
  status             listing_status [not null, default: 'ACTIVE']
  created_at         timestamptz    [not null, default: `now()`]
  updated_at         timestamptz    [not null, default: `now()`]
  deleted_at         timestamptz
}

Table listing_photos [headercolor: #A63D5F] {
  id         uuid         [pk, default: `uuidv7()`]
  listing_id uuid         [not null]
  url        varchar(255) [not null]
  sort_order smallint     [not null, default: 0]
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]
  deleted_at timestamptz
}

Table offers [headercolor: #A63D5F] {
  id             uuid          [pk, default: `uuidv7()`]
  listing_id     uuid          [not null]
  buyer_id       uuid          [not null]
  offered_amount decimal(10,2) [not null]
  message        varchar(255)
  status         offer_status  [not null, default: 'PENDING']
  created_at     timestamptz   [not null, default: `now()`]
  updated_at     timestamptz   [not null, default: `now()`]
  deleted_at     timestamptz
}

Table orders [headercolor: #A63D5F] {
  id                  uuid          [pk, default: `uuidv7()`]
  listing_id          uuid          [not null]
  buyer_id            uuid          [not null]
  seller_id           uuid          [not null]
  shipping_address_id uuid          [not null]
  quantity            integer       [not null, default: 1]
  items_amount        decimal(10,2) [not null]
  shipping_amount     decimal(10,2) [not null, default: 0]
  total_amount        decimal(10,2) [not null]
  shipping_method     varchar(60)   [not null]
  status              order_status  [not null, default: 'AWAITING_PAYMENT']
  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]
  deleted_at          timestamptz
}

Table payments [headercolor: #A63D5F] {
  id                uuid           [pk, default: `uuidv7()`]
  order_id          uuid           [not null, unique]
  method            payment_method [not null]
  value             decimal(10,2)  [not null]
  status            payment_status [not null, default: 'PENDING']
  gateway_reference varchar(120)
  created_at        timestamptz    [not null, default: `now()`]
  updated_at        timestamptz    [not null, default: `now()`]
  deleted_at        timestamptz
}

Table reviews [headercolor: #A63D5F] {
  id         uuid         [pk, default: `uuidv7()`]
  order_id   uuid         [not null, unique]
  author_id  uuid         [not null, note: 'Comprador que avalia']
  seller_id  uuid         [not null, note: 'Vendedor avaliado']
  rating     smallint     [not null, note: '1 a 5']
  comment    varchar(500)
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`]
  deleted_at timestamptz
}

// =====================================================================
// MODULO 7 - NOTIFICACOES E FAVORITOS
// =====================================================================
Table favorites [headercolor: #B08A2E] {
  id         uuid          [pk, default: `uuidv7()`]
  user_id    uuid          [not null]
  type       favorite_type [not null]
  album_id   uuid
  card_id    uuid
  group_id   uuid
  created_at timestamptz   [not null, default: `now()`]
  updated_at timestamptz   [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Exatamente um dos alvos (album_id / card_id / group_id) e preenchido, conforme o campo tipo.'
}

Table price_alerts [headercolor: #B08A2E] {
  id           uuid          [pk, default: `uuidv7()`]
  user_id      uuid          [not null]
  card_id      uuid          [not null]
  target_price decimal(10,2) [not null]
  active       boolean       [not null, default: true]
  created_at   timestamptz   [not null, default: `now()`]
  updated_at   timestamptz   [not null, default: `now()`]
  deleted_at   timestamptz
  Note: 'Alertas de preco (funcionalidade futura).'
}

Table global_notifications [headercolor: #B08A2E] {
  id              uuid         [pk, default: `uuidv7()`]
  admin_id        uuid         [not null]
  title           varchar(120) [not null]
  content         varchar(500) [not null]
  recipient_count integer      [not null, default: 0]
  reference_link  varchar(255) [note: 'Link de destino, copiado para cada notificacao no envio (CCD100)']
  audience        varchar(30) [not null, default: 'ALL', note: 'ALL, ACTIVE_COLLECTORS ou SELLERS (CCD101)']
  channels        varchar(60) [not null, default: 'IN_APP', note: 'Canais separados por virgula: IN_APP, EMAIL (CCD101)']
  status          notification_dispatch_status [not null, default: 'SENT', note: 'SCHEDULED ate o horario programado (CCD100)']
  scheduled_at    timestamptz [note: 'Horario programado (CCD100)']
  sent_at         timestamptz [note: 'Quando a notificacao foi entregue (CCD100)']
  created_at      timestamptz  [not null, default: `now()`]
  updated_at      timestamptz  [not null, default: `now()`]
  deleted_at      timestamptz
}

Table notifications [headercolor: #B08A2E] {
  id                     uuid         [pk, default: `uuidv7()`]
  user_id                uuid         [not null]
  global_notification_id uuid
  title                  varchar(120) [not null]
  message                varchar(500) [not null]
  type                   varchar(40)  [not null]
  reference_link         varchar(255)
  is_read                boolean      [not null, default: false]
  created_at             timestamptz  [not null, default: `now()`]
  updated_at             timestamptz  [not null, default: `now()`]
  deleted_at             timestamptz
}

// =====================================================================
// MODULO 8 - MODERACAO E ADMINISTRACAO
// =====================================================================
Table reports [headercolor: #5A5A66] {
  id               uuid               [pk, default: `uuidv7()`]
  reporter_id      uuid               [not null]
  moderator_id     uuid
  listing_id       uuid
  target_user_id   uuid
  group_message_id uuid
  target_type      report_target_type [not null]
  reason           varchar(90)        [not null]
  description      varchar(500)
  status           report_status      [not null, default: 'PENDING']
  resolved_at      timestamptz
  created_at       timestamptz        [not null, default: `now()`]
  updated_at       timestamptz        [not null, default: `now()`]
  deleted_at       timestamptz
  Note: 'Alvo polimorfico: anuncio, usuario/vendedor/perfil ou mensagem de grupo, conforme target_type.'
}

Table catalog_requests [headercolor: #5A5A66] {
  id             uuid                 [pk, default: `uuidv7()`]
  requester_id   uuid                 [not null]
  reviewed_by_id uuid
  card_id        uuid                 [note: 'Item criado apos aprovacao']
  album_id       uuid                 [note: 'Item criado apos aprovacao']
  type           catalog_request_type [not null]
  data           jsonb                [not null, note: 'Payload com os dados sugeridos pelo usuario']
  status         request_status       [not null, default: 'PENDING']
  reviewed_at    timestamptz
  created_at     timestamptz          [not null, default: `now()`]
  updated_at     timestamptz          [not null, default: `now()`]
  deleted_at     timestamptz
}

Table audit_logs [headercolor: #5A5A66] {
  id          uuid        [pk, default: `uuidv7()`]
  admin_id    uuid        [not null]
  action      varchar(90) [not null]
  entity_type varchar(60) [not null]
  entity_id   uuid
  details     jsonb
  ip_address  varchar(45) [note: 'IP de quem fez a acao (CCD102)']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
  deleted_at  timestamptz
}

Table global_settings [headercolor: #5A5A66] {
  id            uuid         [pk, default: `uuidv7()`]
  updated_by_id uuid
  key           varchar(90)  [not null, unique]
  value         text         [not null]
  description   varchar(255)
  created_at    timestamptz  [not null, default: `now()`]
  updated_at    timestamptz  [not null, default: `now()`]
  deleted_at    timestamptz
}

Table seller_verifications [headercolor: #5A5A66] {
  id                      uuid [pk, default: `uuidv7()`]
  user_id                 uuid [not null, unique]
  reviewed_by_id          uuid
  address_id              uuid
  status                  seller_verification_status [not null, default: 'UNDER_REVIEW']
  legal_name              varchar(160) [not null, note: 'Razao social']
  trade_name              varchar(160) [note: 'Nome fantasia']
  cnpj                    varchar(18) [not null, unique]
  state_registration      varchar(30) [note: 'Inscricao estadual']
  opening_date            date
  company_size            varchar(40) [note: 'Porte, ex.: Microempresa (ME)']
  cnae                    varchar(120) [note: 'CNAE principal']
  responsible_name        varchar(120) [not null, note: 'Responsavel legal']
  responsible_cpf         varchar(14) [not null]
  responsible_phone       varchar(20)
  bank_name               varchar(80)
  bank_branch             varchar(10)
  bank_account            varchar(20)
  pix_key                 varchar(120)
  rejection_reason        varchar(255) [note: 'Motivo da reprovacao']
  regularization_deadline timestamptz [note: 'Prazo da pendencia (CCD095)']
  reviewed_at             timestamptz
  created_at              timestamptz [not null, default: `now()`]
  updated_at              timestamptz [not null, default: `now()`]
  deleted_at              timestamptz
  Note: 'Credenciamento do vendedor (CCD094, CCD095, ADR-052)'
}

Table seller_documents [headercolor: #5A5A66] {
  id                     uuid [pk, default: `uuidv7()`]
  seller_verification_id uuid [not null]
  validated_by_id        uuid
  type                   varchar(60) [not null, note: 'Ex.: CNPJ_CARD, ADDRESS_PROOF']
  file_url               varchar(255) [not null]
  file_size              integer [note: 'Tamanho em bytes']
  status                 seller_document_status [not null, default: 'SUBMITTED']
  validated_at           timestamptz
  created_at             timestamptz [not null, default: `now()`]
  updated_at             timestamptz [not null, default: `now()`]
  deleted_at             timestamptz
  Note: 'Documentos enviados no credenciamento (CCD094, ADR-052)'
}

Table seller_verification_notes [headercolor: #5A5A66] {
  id                     uuid [pk, default: `uuidv7()`]
  seller_verification_id uuid [not null]
  author_id              uuid [not null]
  content                text [not null]
  created_at             timestamptz [not null, default: `now()`]
  updated_at             timestamptz [not null, default: `now()`]
  deleted_at             timestamptz
  Note: 'Anotacao interna da moderacao, invisivel ao vendedor (CCD094, ADR-052)'
}

Table user_warnings [headercolor: #5A5A66] {
  id         uuid [pk, default: `uuidv7()`]
  user_id    uuid [not null]
  admin_id   uuid [not null]
  report_id  uuid
  reason     varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  Note: 'Advertencias aplicadas a usuarios (CCD099, ADR-053)'
}

Table catalog_request_votes [headercolor: #5A5A66] {
  catalog_request_id uuid [not null]
  user_id            uuid [not null]
  vote               catalog_vote [not null]
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]
  deleted_at         timestamptz
  indexes {
    (catalog_request_id, user_id) [pk]
  }
  Note: 'Um voto por cliente em cada solicitacao (CCD103, ADR-053)'
}

Table report_exports [headercolor: #5A5A66] {
  id          uuid [pk, default: `uuidv7()`]
  admin_id    uuid [not null]
  report_type varchar(60) [not null]
  filters     jsonb
  format      varchar(10) [not null, note: 'CSV ou PDF']
  file_url    varchar(255) [not null]
  file_size   integer [note: 'Tamanho em bytes']
  expires_at  timestamptz [not null, note: 'created_at + 90 dias']
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
  deleted_at  timestamptz
  Note: 'Arquivos de relatorio exportados, guardados por 90 dias (CCD107, ADR-053)'
}

// =====================================================================
// RELACIONAMENTOS  ( >  muitos-para-um   |   -  um-para-um )
// =====================================================================

// --- 1. Usuarios, Perfil e Acesso ------------------------------------
Ref: profiles.user_id                  - users.id
Ref: addresses.user_id                > users.id
Ref: password_reset_tokens.user_id > users.id
Ref: refresh_tokens.user_id > users.id
Ref: user_achievements.user_id       > users.id
Ref: user_achievements.achievement_id     > achievements.id
Ref: subscriptions.user_id              > users.id

// --- 2. Catalogo Global ----------------------------------------------
Ref: categories.parent_category_id > categories.id
Ref: albums.category_id         > categories.id
Ref: cards.album_id             > albums.id
Ref: cards.category_id         > categories.id
Ref: cards.rarity_id          > rarities.id
Ref: cards.language_id            > languages.id
Ref: card_photos.card_id        > cards.id
Ref: price_history.card_id   > cards.id

// --- 3. Colecao do Cliente -------------------------------------------
Ref: collections.user_id       - users.id
Ref: user_albums.collection_id > collections.id
Ref: user_albums.album_id   > albums.id
Ref: collection_cards.collection_id > collections.id
Ref: collection_cards.card_id   > cards.id

// --- 4. Comunidade (Grupos) ------------------------------------------
Ref: groups.creator_id                      > users.id
Ref: group_members.group_id                 > groups.id
Ref: group_members.user_id               > users.id
Ref: group_join_requests.group_id            > groups.id
Ref: group_join_requests.user_id          > users.id
Ref: group_join_requests.reviewed_by_id     > users.id
Ref: group_messages.group_id               > groups.id
Ref: group_messages.author_id               > users.id
Ref: group_messages.reply_to_id > group_messages.id
Ref: group_messages.card_id               > cards.id
Ref: group_messages.listing_id             > listings.id
Ref: polls.group_message_id             - group_messages.id
Ref: poll_options.poll_id              > polls.id
Ref: poll_votes.poll_option_id         > poll_options.id
Ref: poll_votes.user_id               > users.id

// --- 5. Chat Pessoal --------------------------------------------------
Ref: conversation_participants.conversation_id > conversations.id
Ref: conversation_participants.user_id  > users.id
Ref: messages.conversation_id              > conversations.id
Ref: messages.author_id                 > users.id
Ref: messages.reply_to_id   > messages.id
Ref: conversations.listing_id               > listings.id
Ref: user_blocks.blocker_id    > users.id
Ref: user_blocks.blocked_id     > users.id

// --- 6. Marketplace ---------------------------------------------------
Ref: listings.seller_id           > users.id
Ref: listings.card_id              > cards.id
Ref: listings.condition_id > card_conditions.id
Ref: listing_photos.listing_id       > listings.id
Ref: offers.listing_id           > listings.id
Ref: offers.buyer_id         > users.id
Ref: orders.listing_id             > listings.id
Ref: orders.buyer_id           > users.id
Ref: orders.seller_id            > users.id
Ref: orders.shipping_address_id    > addresses.id
Ref: payments.order_id           - orders.id
Ref: reviews.order_id           - orders.id
Ref: reviews.author_id            > users.id
Ref: reviews.seller_id         > users.id

// --- 7. Notificacoes e Favoritos --------------------------------------
Ref: favorites.user_id               > users.id
Ref: favorites.album_id                 > albums.id
Ref: favorites.card_id                 > cards.id
Ref: favorites.group_id                 > groups.id
Ref: price_alerts.user_id           > users.id
Ref: price_alerts.card_id             > cards.id
Ref: notifications.user_id            > users.id
Ref: notifications.global_notification_id > global_notifications.id
Ref: global_notifications.admin_id       > users.id

// --- 8. Moderacao e Administracao -------------------------------------
Ref: reports.reporter_id               > users.id
Ref: reports.moderator_id                 > users.id
Ref: reports.listing_id                   > listings.id
Ref: reports.target_user_id              > users.id
Ref: reports.group_message_id            > group_messages.id
Ref: catalog_requests.requester_id   > users.id
Ref: catalog_requests.reviewed_by_id  > users.id
Ref: catalog_requests.card_id         > cards.id
Ref: catalog_requests.album_id         > albums.id
Ref: audit_logs.admin_id                > users.id
Ref: global_settings.updated_by_id > users.id
Ref: seller_verifications.user_id - users.id
Ref: seller_verifications.reviewed_by_id > users.id
Ref: seller_verifications.address_id > addresses.id
Ref: seller_documents.seller_verification_id > seller_verifications.id
Ref: seller_documents.validated_by_id > users.id
Ref: seller_verification_notes.seller_verification_id > seller_verifications.id
Ref: seller_verification_notes.author_id > users.id
Ref: user_warnings.user_id > users.id
Ref: user_warnings.admin_id > users.id
Ref: user_warnings.report_id > reports.id
Ref: catalog_request_votes.catalog_request_id > catalog_requests.id
Ref: catalog_request_votes.user_id > users.id
Ref: report_exports.admin_id > users.id

// =====================================================================
// AGRUPAMENTOS VISUAIS
// =====================================================================
TableGroup "1 - Usuarios, Perfil e Acesso" {
  users
  profiles
  addresses
  password_reset_tokens
  refresh_tokens
  achievements
  user_achievements
  subscriptions
}

TableGroup "2 - Catalogo Global" {
  categories
  rarities
  languages
  card_conditions
  albums
  cards
  card_photos
  price_history
}

TableGroup "3 - Colecao do Cliente" {
  collections
  user_albums
  collection_cards
}

TableGroup "4 - Comunidade (Grupos)" {
  groups
  group_members
  group_join_requests
  group_messages
  polls
  poll_options
  poll_votes
}

TableGroup "5 - Chat Pessoal" {
  conversations
  conversation_participants
  message
  user_blocks
}

TableGroup "6 - Marketplace" {
  listings
  listing_photos
  offers
  orders
  payments
  reviews
}

TableGroup "7 - Notificacoes e Favoritos" {
  favorites
  price_alerts
  notifications
  global_notifications
}

TableGroup "8 - Moderacao e Administracao" {
  reports
  catalog_requests
  audit_logs
  global_settings
  seller_verifications
  seller_documents
  seller_verification_notes
  user_warnings
  catalog_request_votes
  report_exports
}

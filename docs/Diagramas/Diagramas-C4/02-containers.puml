@startuml 02_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Containers (C4 - Nivel 2) - Sistema de Gestao de Cartas Colecionaveis

Person(visitante, "Visitante", "Usuario nao autenticado")
Person(cliente, "Cliente", "Colecionador autenticado")
Person(vendedor, "Vendedor", "Lojista credenciado que anuncia e vende cartas no marketplace")
Person(admin, "Administrador", "Gestor da plataforma")

System_Boundary(sistema, "Sistema de Gestao de Cartas Colecionaveis") {
    Container(webApp, "Aplicacao Web (SPA)", "React 19 + TypeScript + Vite", "SPA unico, acessado pelo navegador (computador ou celular), com tres areas separadas por rota e papel: Publica (visitantes), Cliente (colecao, grupos, chat, perfil e marketplace) e BackOffice em /backoffice (administradores)")
    Container(api, "API de Aplicacao", "Node.js + Express + Prisma", "Expoe via REST as regras de negocio de catalogo, colecao, grupos, chat, perfil, pagamentos e administracao. Autentica requisicoes via JWT")
    Container(realtime, "Servico de Mensageria em Tempo Real", "Node.js + Socket.IO", "Entrega mensagens de chat pessoal e de grupo em tempo real; conexao autenticada via JWT")
    ContainerDb(db, "Banco de Dados", "PostgreSQL", "Armazena usuarios, cartas, albuns, colecoes, grupos, mensagens, notificacoes, favoritos, pagamentos e assinaturas. Acessado via Prisma ORM")
}

System_Ext(pagamento, "Gateway de Pagamento", "Processa pagamentos e assinaturas (ex: Stripe/Mercado Pago)")
System_Ext(transportadora, "Transportadora", "Empresa terceirizada responsavel pela entrega fisica das cartas compradas no marketplace")

Rel(visitante, webApp, "Usa a area publica", "HTTPS")
Rel(cliente, webApp, "Usa a area do cliente", "HTTPS")
Rel(vendedor, webApp, "Usa a area do cliente e o painel do vendedor", "HTTPS")
Rel(admin, webApp, "Usa o BackOffice (/backoffice)", "HTTPS")

Rel(webApp, api, "Consome", "JSON/HTTPS, JWT no header Authorization")
Rel(webApp, realtime, "Troca mensagens", "WebSocket (Socket.IO), autenticado via JWT")

Rel(api, db, "Le e grava", "SQL via Prisma ORM")
Rel(realtime, db, "Persiste mensagens", "SQL via Prisma ORM")

Rel(api, pagamento, "Processa pagamentos e assinaturas via", "HTTPS/Webhook")
Rel(api, transportadora, "Solicita entrega das cartas compradas via")

SHOW_LEGEND()
@enduml

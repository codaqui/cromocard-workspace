specification {
  element class {
    style {
      shape rectangle
    }
  }
}

model {

  usuario = class "Usuário" {
    metadata {
      atributos """
        - id: Long
        - nome: String
        - email: String
        - senha: String
        - foto: String
        - status: StatusUsuario
        - dataCadastro: DateTime
      """
      metodos """
        + editarPerfil()
        + alterarSenha()
        + excluirConta()
      """
    }
  }

  cliente = class "Cliente" {
    metadata {
      atributos """
        - id: Long
      """
      metodos """
        + visualizarColecao()
        + comprarCarta()
        + solicitarAlbum()
        + compartilharColecao()
        + favoritarCarta()
      """
    }
  }

  administrador = class "Administrador" {
    metadata {
      atributos """
        - id: Long
      """
      metodos """
        + aprovarSolicitacao()
        + gerenciarUsuario()
        + gerenciarCatalogo()
        + gerarRelatorio()
        + visualizarAuditoria()
      """
    }
  }

  album = class "Álbum" {
    metadata {
      atributos """
        - id: Long
        - nome: String
        - descricao: String
        - ano: Integer
        - capa: String
        - status: StatusAlbum
      """
      metodos """
        + adicionarCarta()
        + removerCarta()
        + visualizarCartas()
        + compartilharAlbum()
      """
    }
  }

  carta = class "Carta" {
    metadata {
      atributos """
        - id: Long
        - nome: String
        - numero: String
        - imagem: String
        - raridade: Raridade
        - idioma: String
        - categoria: String
      """
      metodos """
        + visualizarDetalhes()
        + consultarHistoricoPreco()
        + pesquisar()
      """
    }
  }

  itemColecao = class "ItemColecao" {
    metadata {
      atributos """
        - id: Long
        - quantidade: Integer
        - status: StatusColecao
        - dataAdicao: DateTime
      """
      metodos """
        + adicionarCarta()
        + removerCarta()
        + alterarQuantidade()
        + marcarComoPossuida()
        + marcarComoFaltante()
        + marcarComoRepetida()
        + resetarProgresso()
      """
    }
  }

  vendedor = class "Vendedor" {
    metadata {
      atributos """
        - id: Long
        - reputacao: Decimal
      """
      metodos """
        + criarAnuncio()
        + editarAnuncio()
        + excluirAnuncio()
        + pausarAnuncio()
        + reativarAnuncio()
        + visualizarVendas()
      """
    }
  }

  anuncio = class "Anúncio" {
    metadata {
      atributos """
        - id: Long
        - titulo: String
        - descricao: String
        - preco: Decimal
        - quantidade: Integer
        - estadoConservacao: EstadoConservacao
        - status: StatusAnuncio
        - dataPublicacao: DateTime
      """
      metodos """
        + criar()
        + editar()
        + excluir()
        + pausar()
        + reativar()
        + alterarPreco()
        + visualizarDetalhes()
      """
    }
  }

  pedido = class "Pedido" {
    metadata {
      atributos """
        - id: Long
        - data: DateTime
        - valorTotal: Decimal
        - status: StatusPedido
      """
      metodos """
        + adicionarItem()
        + removerItem()
        + calcularTotal()
        + cancelar()
        + finalizar()
      """
    }
  }

  itemPedido = class "ItemPedido" {
    metadata {
      atributos """
        - id: Long
        - quantidade: Integer
        - precoUnitario: Decimal
      """
      metodos """
        + calcularSubtotal()
        + alterarQuantidade()
      """
    }
  }

  avaliacao = class "Avaliação" {
    metadata {
      atributos """
        - id: Long
        - nota: Integer
        - comentario: String
        - data: DateTime
      """
      metodos """
        + criar()
        + editar()
        + excluir()
      """
    }
  }

  historicoPreco = class "HistóricoPreco" {
    metadata {
      atributos """
        - id: Long
        - preco: Decimal
        - data: DateTime
      """
      metodos """
        + registrarPreco()
        + consultarHistorico()
      """
    }
  }

  alertaPreco = class "AlertaPreco" {
    metadata {
      atributos """
        - id: Long
        - precoDesejado: Decimal
        - ativo: Boolean
      """
      metodos """
        + criar()
        + ativar()
        + desativar()
        + verificarPreco()
      """
    }
  }

}

views {
  view DiagramaClasses {
    title "Diagrama de Classes - Marketplace de Cartas"
    include *
    autoLayout TopBottom
  }
}
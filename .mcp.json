{
  "mcpServers": {
    "azure-devops": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@2.10.0",
        "CromoCard",
        "--authentication",
        "${AZURE_DEVOPS_AUTH:-pat}",
        "--domains",
        "core",
        "work",
        "work-items",
        "search",
        "wiki"
      ],
      "env": {
        "PERSONAL_ACCESS_TOKEN": "${AZURE_DEVOPS_PAT:-}"
      }
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
